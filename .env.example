# Copy the relevant lines into .env and fill them in. .env is gitignored.

# ── Chatbot ──────────────────────────────────────────────────────────────
# Base URL of the chat backend used by src/lib/chat.api.ts.
NEXT_PUBLIC_API_URL=

# ── CV to Job Guestimator ────────────────────────────────────────────────
# Base URL of the CV_to_Job_Guestimator FastAPI service (the src/api/routes.py
# app), WITHOUT a trailing slash and WITHOUT the /api suffix — the route
# handlers in src/app/api/cv/* append their own paths.
#
# Locally that service runs on port 8000:
#     uv run uvicorn src.api.app:app --port 8000
# Note this is NOT the Modal URL. Modal hosts the vLLM model server that the
# FastAPI app itself calls; the browser never talks to either directly.
#
# Server-only (no NEXT_PUBLIC_ prefix): it must not reach the client bundle.
CV_GUESTIMATOR_API_URL=http://127.0.0.1:8000

# Optional. Sent as `Authorization: Bearer <key>` to the FastAPI service.
# That app is currently unauthenticated, so leave this empty until it isn't.
CV_GUESTIMATOR_API_KEY=

# Optional. How long to wait for a scoring run, in ms. Default 180000 (3 min),
# which is long enough to ride out a Modal cold start — booting vLLM and
# loading the LoRA takes minutes, not seconds.
CV_GUESTIMATOR_TIMEOUT_MS=

# Optional. Per-IP rate limit for the CV endpoints, since each run wakes an L4
# GPU. Defaults: 5 requests per 900000 ms (15 minutes).
CV_GUESTIMATOR_RATE_LIMIT=
CV_GUESTIMATOR_RATE_WINDOW_MS=
